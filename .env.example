# KALYX Environment Configuration
# Note: Never commit production credentials to source control.

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Supabase Configuration (Optional for Google OAuth / remote database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth Credentials (configured in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Administrator Bootstrap
# Comma-separated list of authorized administrator email addresses
ADMIN_EMAILS=admin@kalyx.edu,registrar@kalyx.edu
